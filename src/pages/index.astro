---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p>
				I’m Xianhang Lin. I write about my experiences with large language models, machine learning
				for robotics, like vision-language-action models, and the engineering behind training and
				serving these systems.
			</p>
			{
				latest && (
					<>
						<h2>Latest</h2>
						<p>
							<a href={`/blog/${latest.id}/`}>{latest.data.title}</a>
							<br />
							<span class="meta">
								<FormattedDate date={latest.data.pubDate} /> — {latest.data.description}
							</span>
						</p>
					</>
				)
			}
			<p><a href="/blog">All posts →</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.meta {
		color: rgb(var(--gray));
		font-size: 0.95em;
	}
	h2 {
		margin-top: 1.5em;
		font-size: 1.25em;
	}
</style>
